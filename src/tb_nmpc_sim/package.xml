<?xml version="1.0"?>
<package format="3">
  <name>tb_nmpc_sim</name>
  <version>0.1.0</version>
  <description>Webots world for tb_nmpc: TurtleBot3 Burger on a figure eight with static obstacles and a crossing pedestrian.</description>
  <maintainer email="clementdumeril@gmail.com">Clement Dumeril</maintainer>
  <license>MIT</license>

  <exec_depend>tb_nmpc</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>
  <exec_depend>webots_ros2_control</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
