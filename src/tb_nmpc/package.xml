<?xml version="1.0"?>
<package format="3">
  <name>tb_nmpc</name>
  <version>0.1.0</version>
  <description>acados NMPC with lidar obstacle tracking and prediction for TurtleBot, and a Nav2 path feeder for the baselines.</description>
  <maintainer email="clementdumeril@gmail.com">Clement Dumeril</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Only for the Nav2 baselines (nav2_follow, nav2_controller.launch.py). -->
  <exec_depend>nav2_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
